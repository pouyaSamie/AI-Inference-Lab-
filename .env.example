# AI Inference Optimization Lab — local development configuration.
# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# Generate secrets with: openssl rand -hex 32

# ---------------------------------------------------------------- controller
LAB_ENVIRONMENT=dev
LAB_API_HOST=127.0.0.1
LAB_API_PORT=8787
LAB_LOG_LEVEL=INFO

# Two separate SQLite files are mandatory.
LAB_CONTROLLER_DB_URL=sqlite:///./var/controller.sqlite3
LAB_OPTIMIZER_DB_URL=sqlite:///./var/optuna.sqlite3
LAB_SQLITE_BUSY_TIMEOUT_MS=10000
LAB_SQLITE_SYNCHRONOUS=FULL

# Required credentials (16+ characters each).
LAB_OPERATOR_TOKEN=CHANGE_ME_operator_token_000000000000
LAB_ENROLLMENT_TOKEN=CHANGE_ME_enrollment_token_0000000000
LAB_OPTIMIZER_TOKEN=CHANGE_ME_optimizer_token_0000000000
LAB_WORKER_TOKEN_PEPPER=CHANGE_ME_worker_token_pepper_00000000

LAB_ARTIFACT_ROOT=./var/artifacts
# JSON arrays must be single-quoted so dotenv preserves the inner double quotes.
LAB_ALLOWED_MODEL_ROOTS='["/home/pouya/ai-lab/models"]'
LAB_CORS_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173"]'

# Phase 2 accepts the real execution lane. The simulated lane remains explicit
# and its observations can never produce a validated recipe.
LAB_EXECUTION_MODE=real
LAB_ALLOW_SIMULATION=true
LAB_SCAN_HASH_MODELS=true

LAB_SCHEDULER_ENABLED=true
LAB_SCHEDULER_INTERVAL_SECONDS=0.5
LAB_WORKER_LEASE_SECONDS=120
LAB_WORKER_LEASE_MAX_SECONDS=21600
LAB_WORKER_OFFLINE_AFTER_SECONDS=120
LAB_SNAPSHOT_MAX_AGE_SECONDS=86400
LAB_OPTIMIZER_LEASE_SECONDS=60
LAB_OPTIMIZER_OFFLINE_AFTER_SECONDS=30
LAB_SSE_POLL_INTERVAL_SECONDS=0.25
LAB_SSE_BATCH_SIZE=200
LAB_SSE_KEEPALIVE_SECONDS=15

# ------------------------------------------------------------------- worker
# The real worker probes only the configured paths, hashes models under the
# configured roots, and writes state/sandboxes/journals beneath STATE_ROOT.
LAB_WORKER_CONTROLLER_URL=http://127.0.0.1:8787
LAB_WORKER_ENROLLMENT_TOKEN=CHANGE_ME_enrollment_token_0000000000
LAB_WORKER_WORKER_TOKEN=
LAB_WORKER_WORKER_ID=linux-worker-1
LAB_WORKER_WORKER_NAME="Linux inference worker"
LAB_WORKER_STATE_FILE=./var/worker-state.json
LAB_WORKER_STATE_ROOT=./var/worker
LAB_WORKER_EXECUTION_MODE=real
LAB_WORKER_SIMULATED=false
LAB_WORKER_MODEL_ROOTS='["/home/pouya/ai-lab/models"]'
LAB_WORKER_GPU_UUIDS='[]'
LAB_WORKER_POLL_SECONDS=1.0
LAB_WORKER_HEARTBEAT_SECONDS=10.0
LAB_WORKER_LEASE_RENEW_SECONDS=30.0
LAB_WORKER_MAX_COMMANDS=1
LAB_WORKER_HASHING_ENABLED=true

# Installed engine locations (override on another host).
LAB_WORKER_LLAMA_SERVER_PATH=/home/pouya/ai-lab/Inference/llama-cpp/builds/linux/latest-candidate/bin/llama-server
LAB_WORKER_LLAMA_BENCH_PATH=/home/pouya/ai-lab/Inference/llama-cpp/builds/linux/latest-candidate/bin/llama-bench
LAB_WORKER_LLAMA_LIB_DIR=/home/pouya/ai-lab/Inference/llama-cpp/builds/linux/latest-candidate/bin
LAB_WORKER_STRATA_PATH=/home/pouya/ai-lab/Inference/strata/builds/linux/v0.1.44.1-candidate/strata
LAB_WORKER_STRATA_SOURCE_ROOT=/home/pouya/ai-lab/Inference/strata/source
LAB_WORKER_STRATA_SERVER_SCRIPT=/home/pouya/ai-lab/Inference/strata/source/serve/server.py

# Simulated worker lane (`lab-worker-sim`). These labels are not read as files.
LAB_WORKER_MODEL_ID=qwen2.5-7b-instruct-q4_k_m
LAB_WORKER_MODEL_PATH=/home/pouya/ai-lab/models/qwen2.5-7b-instruct-q4_k_m.gguf
LAB_WORKER_ENGINE_PATH=/home/pouya/ai-lab/Inference/llama-cpp/builds/linux/latest-candidate/bin/llama-server

# ----------------------------------------------------------------- optimizer
LAB_OPTIMIZER_CONTROLLER_URL=http://127.0.0.1:8787
LAB_OPTIMIZER_TOKEN=CHANGE_ME_optimizer_token_0000000000
LAB_OPTIMIZER_DB_URL=sqlite:///./var/optuna.sqlite3
LAB_OPTIMIZER_OPTIMIZER_ID=optimizer-local-1
LAB_OPTIMIZER_POLL_SECONDS=1.0
LAB_OPTIMIZER_HEARTBEAT_SECONDS=10.0
