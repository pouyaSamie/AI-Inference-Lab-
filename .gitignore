# ==========================================
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# ==========================================
# 2. Secrets, Credentials & Local Env
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/
*token*
!packages/client-contracts/**
!python/**

# ==========================================
# 3. Python (FastAPI, Optuna, Workers)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments & packaging
.venv/
venv/
ENV/
env/

# Pytest, Mypy, Ruff & Coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# ==========================================
# 4. Databases & Local Storage (v2.1 Dual SQLite WAL)
# ==========================================
*.db
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db-shm
*.db-wal
*.journal

# ==========================================
# 5. Node / pnpm / React / Vite / Electron
# ==========================================
node_modules/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.tsbuildinfo
*.tsbuildinfo

# Build & Packaged Desktop Outputs (.deb, AppImage)
dist/
dist-electron/
dist-ssr/
release/
out/
*.AppImage
*.deb
*.rpm
*.snap
*.tar.gz

# Playwright & Vitest UI E2E Artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ==========================================
# 6. AI Models, Engines & Benchmark Artifacts
# ==========================================
# Never commit model weights or engine binaries
*.gguf
*.bin
*.safetensors
*.onnx
models/
engines/

# Runtime sandboxes, telemetry chunks & raw logs
artifacts/
sandboxes/
workspaces/
logs/
*.log
calibration.json
mixed-results/

# Keep pinned test fixtures & generated contracts tracked!
!fixtures/**
!contracts/openapi.yaml
!contracts/schemas/**
